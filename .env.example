# LLM (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ACTOR_MODEL=meta-llama/llama-3.3-70b-instruct
CRITIC_MODEL=meta-llama/llama-3.3-70b-instruct
GRADER_MODEL=meta-llama/llama-3.3-70b-instruct
AGENT_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
LLM_MAX_RETRIES=4

# retrieval
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=frag
TOP_K=8
RERANK=off
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# corrective retrieval (CRAG)
CORRECTIVE=off
CORRECTIVE_MAX_REWRITES=2
CORRECTIVE_MIN_RELEVANT=1

# gates
CRITIC=off
CRITIC_MIN_SCORE=0.8
ROUTER_LLM=off
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=8

# observability (self-hosted Langfuse; keys from the Langfuse UI after `docker compose up`)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

LOG_LEVEL=INFO
LOG_JSON=true
